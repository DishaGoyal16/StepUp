rules_version = '2';

// StepUp - Cloud Storage rules. Only profile photos exist: profilePhotos/{uid}/{file}.
// Owner writes (image only, <= 2 MB); any eligible (verified @thapar.edu) user may read. Everything else is denied.

service firebase.storage {
  match /b/{bucket}/o {

    function eligible() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('^[^@\\s]+@thapar\\.edu$');
    }

    match /profilePhotos/{uid}/{file} {
      allow read: if eligible();

      allow create, update: if eligible()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)');

      allow delete: if eligible() && request.auth.uid == uid;
    }
  }
}
