<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- DEBUG BUILDS ONLY: the Firebase Emulator Suite is plain HTTP (adb reverse -> 127.0.0.1 / 10.0.2.2).
         Android 9+ blocks cleartext traffic by default, so Auth/Firestore/Functions/Storage emulator calls
         would fail. This overlay is merged only into debug builds; the main and release
         manifests keep the default (cleartext blocked). -->
    <application android:usesCleartextTraffic="true" />
</manifest>
