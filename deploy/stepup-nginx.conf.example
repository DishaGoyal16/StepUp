server {
    listen 80;
    server_name stepup.example.org;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/stepup-acme;
        try_files $uri =404;
    }
    location / { return 308 https://stepup.example.org$request_uri; }
}
server {
    listen 443 ssl;
    server_name stepup.example.org;
    ssl_certificate /etc/letsencrypt/live/stepup.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stepup.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/stepup;
    client_max_body_size 27m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    location = / { try_files /index.html =404; }
    location = /index.html { try_files $uri =404; }
    location = /Combined_Presentations.pdf { try_files $uri =404; }
    location /presentations/ { try_files $uri =404; }
    location = /api/db-test { return 404; }
    location ~ ^/(admin(?:/|$)|api/) {
        proxy_pass http://127.0.0.1:4001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / { return 404; }
}
